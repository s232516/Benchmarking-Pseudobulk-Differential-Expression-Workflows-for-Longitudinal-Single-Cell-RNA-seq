set.seed(42)
# Create empty parameter object
myParams <- rescueSim::RescueSimParams()
# Fill in basic experimental design
myParams@nTimepoints     <- 2                 # T0 and T1
myParams@twoGroupDesign  <- TRUE              # two groups (treatment vs control)
myParams@nSubjsPerGroup  <- 10                # 10 subjects per group
myParams@minCellsPerSamp <- 150               # min cells per sample
myParams@maxCellsPerSamp <- 200               # max cells per sample
myParams@logLibMean  <- 11.0   # average library size on log scale (~60k reads)
myParams@logLibSD    <- 0.4    # variability of library sizes
myParams@logLibFacVar <- 0.2   # variability between samples
nGenes <- 5000
myParams@exprsMean <- rgamma(nGenes, shape = 2, rate = 1/0.5)   # mean expr ≈ 1–10
myParams@dispersion <- rgamma(nGenes, shape = 2, rate = 1/1)    # overdispersion
names(myParams@exprsMean) <- paste0("Gene", seq_len(nGenes))
names(myParams@dispersion) <- names(myParams@exprsMean)
myParams@sampleFacVarMean <- -2   # modest between-sample variance
myParams@sampleFacVarSD   <- 0.5
myParams@subjectFacVarMean <- -1  # between-subject variance (higher than sample-level)
myParams@subjectFacVarSD   <- 0.5
# baseline (time1) is the reference
myParams@propDE <- 0.10        # 10% of genes are DE at any change
de_genes <- sample(names(myParams@exprsMean), nGenes * myParams@propDE)
de_idx <- match(de_genes, names(myParams@exprsMean))
# All genes initially unchanged
log2FC_list <- list(
"time2_group1" = rep(0, nGenes),  # placebo T1
"time2_group2" = rep(0, nGenes)   # treatment T1, DE genes will be modified
)
# Only DE genes in treatment T1 get log2FC
log2FC_list[["time2_group2"]][de_idx] <- rnorm(length(de_idx), mean = 1.0, sd = 0.2)
# assign to parameters
myParams@deLog2FC <- log2FC_list
# assign to parameters
myParams@deLog2FC <- log2FC_list
sim <-  rescueSim::simRescueData(myParams)
sim <- scater::logNormCounts(sim)
sim <- scater::runPCA(sim, ncomponents = 10)
sim <- scater::runUMAP(sim, dimred = "PCA")
head(colData(sim))
sim <- scater::runPCA(sim, ncomponents = 10)
sim <- scater::runUMAP(sim, dimred = "PCA")
scater::plotPCA(sim, colour_by ="GroupTime")
SummarizedExperiment::colData(sim)$GroupTime <- paste0(
SummarizedExperiment::colData(sim)$group, "_",
SummarizedExperiment::colData(sim)$time
)
sim <- scater::runPCA(sim, ncomponents = 10)
scater::plotPCA(sim, colour_by ="GroupTime")
scater::plotUMAP(
sim,
colour_by = "GroupTime",
point_size = 3
)
