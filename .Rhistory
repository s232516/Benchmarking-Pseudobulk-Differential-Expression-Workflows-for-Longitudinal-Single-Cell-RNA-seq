summarise_ci_coverage <- function(df, conf_level = 0.95) {
z <- qnorm(1 - (1 - conf_level) / 2)
df <- df |>
dplyr::filter(
!is.na(trueDE),
!is.na(true_logFC),
!is.na(log2FoldChange),
!is.na(lfcSE)
) |>
dplyr::mutate(
lower = log2FoldChange - z * lfcSE,
upper = log2FoldChange + z * lfcSE,
in_ci = true_logFC >= lower & true_logFC <= upper,
regulation = dplyr::case_when(
true_logFC > 0 ~ "up",
true_logFC < 0 ~ "down",
TRUE ~ "not_sig"
)
)
dplyr::tibble(
total_genes = nrow(df),
in_ci_total = sum(in_ci, na.rm = TRUE),
total_up = sum(regulation == "up", na.rm = TRUE),
in_ci_up = sum(in_ci & regulation == "up", na.rm = TRUE),
total_down = sum(regulation == "down", na.rm = TRUE),
in_ci_down = sum(in_ci & regulation == "down", na.rm = TRUE),
total_not_sig = sum(regulation == "not_sig", na.rm = TRUE),
in_ci_not_sig = sum(in_ci & regulation == "not_sig", na.rm = TRUE)
)
}
