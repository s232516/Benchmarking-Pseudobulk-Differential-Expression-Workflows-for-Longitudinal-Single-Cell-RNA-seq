SummarizedExperiment::colData(sca)$Condition <- factor(SummarizedExperiment::colData(sca)$Condition,
levels = c("Placebo", "Treatment"))
# Placebo = baseline
SummarizedExperiment::colData(sca)$Sample <- factor(SummarizedExperiment::colData(sca)$Sample)
zlmCond <- MAST::zlm(~ Condition, sca)
# Likelihood ratio test
summaryCond <- MAST::summary(zlmCond, doLRT = "ConditionTreatment")
# Get the full datatable
summaryDt <- summaryCond$datatable
# Extract log2FC, SE, z
fc <- summaryDt[contrast == "ConditionTreatment" & component == "logFC",
.(gene = primerid, log2FoldChange = coef, stat = z)]
# Extract likelihood ratio test p-values (H = hurdle test)
pval <- summaryDt[contrast == "ConditionTreatment" & component == "H",
.(gene = primerid, pvalue = `Pr(>Chisq)`)]
# Merge together
mast_res <- merge(fc, pval, by = "gene")
# Adjusted p-values
mast_res$padj <- p.adjust(mast_res$pvalue, method = "fdr")
# Order by significance
mast_res <- mast_res[order(mast_res$padj), ]
##### Visualization (Volcano Plot) ---------------------------------------------
df_mast <- as.data.frame(mast_res)
df_mast <- df_mast |>
dplyr::mutate(neg_log10_pvalue = -log10(.data$pvalue))|>
dplyr::arrange(.data$pvalue) |>
dplyr::mutate(significance = dplyr::case_when((.data$padj <= 0.05) &
(.data$log2FoldChange > 0) ~
"Downregulated",
(.data$padj <= 0.05) &
(.data$log2FoldChange < 0) ~
"Upregulated",
TRUE ~ "Not significant"
))
color_order <- c(
"Upregulated" = "#b2182b", "Downregulated" = "#2166ac",
"Not significant" = "#c0c0c0"
)
volcano_plot(data = df_mast, x = "log2FoldChange", y = "pvalue",
color_col = "significance", colors = color_order,
vline = 0, labels = "gene", y_axis_title = "P-value",
x_axis_title = "Effect Size"
) + ggplot2::theme(
aspect.ratio = 1,
text = ggplot2::element_text(size = 18)
)
### Bulk Methods --------------------------------------------------------
#### Running DESeq2-------------------------------------------------------------
# Extract counts
rawData <- as.matrix(SummarizedExperiment::assay(sim.pop.cond, "counts"))
# Extract condition labels
coldata <- as.data.frame(SummarizedExperiment::colData(sim.pop.cond))
SampleName <- c(colnames(rawData))
condition <- coldata$Condition
# generate the metadata data frame
meta_data <- data.frame(SampleName, condition)
meta_data <- meta_data |>
tibble::column_to_rownames(var="SampleName")
dds <- DESeq2::DESeqDataSetFromMatrix(countData = rawData,
colData = meta_data,
design = ~ condition)
# filter any counts less than 10
keep <- rowSums(SingleCellExperiment::counts(dds)) >= 10
dds <- dds[keep,]
# set the reference to be the control
dds$condition <- relevel(dds$condition, ref = 'Placebo')
# get normalized counts
dds <- BiocGenerics::estimateSizeFactors(dds)
normalized_counts <- SingleCellExperiment::counts(dds, normalized = TRUE)
dds <- DESeq2::DESeq(dds)
res <- DESeq2::results(dds)
res
##### Visualization(Volcano Plot) ---------------------------------------------
df <- as.data.frame(res) |>
tibble::rownames_to_column(var = "gene")
df <- df |>
dplyr::mutate(neg_log10_pvalue = -log10(.data$pvalue))|>
dplyr::arrange(.data$pvalue) |>
dplyr::mutate(significance = dplyr::case_when((.data$padj <= 0.05) &
(.data$log2FoldChange > 0) ~
"Downregulated",
(.data$padj <= 0.05) &
(.data$log2FoldChange < 0) ~
"Upregulated",
TRUE ~ "Not significant"
))
color_order <- c(
"Upregulated" = "#b2182b", "Downregulated" = "#2166ac",
"Not significant" = "#c0c0c0"
)
volcano_plot(data = df, x = "log2FoldChange", y = "pvalue",
color_col = "significance", colors = color_order,
vline = 0, labels = "gene", y_axis_title = "P-value",
x_axis_title = "Effect Size"
) + ggplot2::theme(
aspect.ratio = 1,
text = ggplot2::element_text(size = 18)
)
# real vs simulated ------------------------------------------------------------
expr <- as.matrix(SingleCellExperiment::logcounts(sim.pop.cond))
condition <- SingleCellExperiment::colData(sim.pop.cond)$Condition
true_effects <- data.frame(
gene = rownames(expr),
TrueEffect = apply(expr, 1, function(x) {
mean(x[condition == "Treatment"]) - mean(x[condition == "Placebo"])
})
)
#  MAST
mast_compare <- mast_res |>
dplyr::mutate(
Method = "MAST",
EstimatedEffect = log2FoldChange,
SE = abs(log2FoldChange / stat)
)  |>
dplyr::select(gene, Method, EstimatedEffect, SE)
# DESeq
deseq_compare <- df |>
dplyr::mutate(
Method = "DESeq2",
EstimatedEffect = log2FoldChange,
SE = lfcSE
) |>
dplyr::select(gene, Method, EstimatedEffect, SE)
# Combine
compare_all <- bind_rows(mast_compare, deseq_compare) |>
dplyr::left_join(true_effects, by = "gene")
ggplot2::ggplot(compare_all,
ggplot2::aes(x = TrueEffect,
y = EstimatedEffect,
color = Method)) +
ggplot2::geom_point(alpha = 1) +
ggplot2::geom_errorbar(ggplot2::aes(ymin = EstimatedEffect - 1.96 * SE,
ymax = EstimatedEffect + 1.96 * SE),
width = 0, alpha = 01) +
ggplot2::geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
ggplot2::facet_wrap(~ Method) +
ggplot2::labs(
title = "True vs Estimated Effect Sizes with 95% CI",
x = "True Simulated Effect",
y = "Estimated Effect"
) +
ggplot2::theme_bw()
## Methods --------------------------------------------------------------------
### Single Cell Methods (Mixed Linear Models) -----------------------------------
#### Running MAST---------------------------------------------------------------
# Run the MAST hurdle model with random effect
zlmCond_ran <- MAST::zlm(
~ Condition + (1 | Sample),
sca,
method = "glmer",
ebayes = FALSE,
strictConvergence = FALSE
)
# Each gene is treated independently.
#
# No shrinkage of log2 fold-changes occurs.
#
# Your effect sizes might be more “noisy” for low-count genes but represent the raw estimated coefficients.
# MAST uses glmer() from lme4 under the hood to fit the mixed model. glmer()
# uses iterative numerical optimization, and sometimes it fails to converge
# perfectly, especially with small datasets or near-zero variance components.
#
# strictConvergence = TRUE:
#
#   MAST will stop and throw an error if the optimizer fails to converge.
#
# strictConvergence = FALSE:
#
#   MAST will allow the model to return the current estimates even if
# convergence warnings occur.
#
# Useful for small or tricky datasets to get results without aborting.
#
# In short: FALSE = “try to return estimates even if convergence is not perfect,
#  ” TRUE = stop on convergence problems.
# Likelihood ratio test
summaryCond_ran <- MAST::summary(zlmCond_ran, doLRT = "ConditionTreatment")
# Extract table
summaryDt_ran <- summaryCond_ran$datatable
# Extract logFC and z-stat
fc_ran <- summaryDt_ran[
contrast == "ConditionTreatment" & component == "logFC",
.(gene = primerid, log2FoldChange = coef, stat = z)
]
# Extract likelihood ratio p-values
pval_ran <- summaryDt_ran[
contrast == "ConditionTreatment" & component == "H",
.(gene = primerid, pvalue = `Pr(>Chisq)`)
]
# Merge results
mast_res_ran <- merge(fc_ran, pval_ran, by = "gene")
# Adjust p-values (correct column name!)
mast_res_ran$padj <- p.adjust(mast_res_ran$pvalue, method = "fdr")
# Order by significance
mast_res_ran <- mast_res_ran[order(mast_res_ran$padj), ]
##### Volcano Plot -------------------------------------------------------------
df_mast_ran <- as.data.frame(mast_res_ran)
df_mast_ran <- df_mast_ran |>
dplyr::mutate(
neg_log10_pvalue = -log10(pvalue),
significance = dplyr::case_when(
padj <= 0.05 & log2FoldChange > 0 ~ "Upregulated",
padj <= 0.05 & log2FoldChange < 0 ~ "Downregulated",
TRUE ~ "Not significant"
)
)
volcano_plot(
data = df_mast_ran,
x = "log2FoldChange",
y = "pvalue",
color_col = "significance",
colors = c("Upregulated" = "#b2182b", "Downregulated" = "#2166ac", "Not significant" = "#c0c0c0"),
vline = 0,
labels = "gene",
y_axis_title = "P-value",
x_axis_title = "Effect Size"
) +
ggplot2::theme(
aspect.ratio = 1,
text = ggplot2::element_text(size = 18)
)
# real vs simulated ------------------------------------------------------------
#  MAST
mast_compare <- mast_res_ran |>
dplyr::mutate(
Method = "MAST",
EstimatedEffect = log2FoldChange,
SE = abs(log2FoldChange / stat)
)  |>
dplyr::select(gene, Method, EstimatedEffect, SE)
# DESeq
deseq_compare <- df |>
dplyr::mutate(
Method = "DESeq2",
EstimatedEffect = log2FoldChange,
SE = lfcSE
) |>
dplyr::select(gene, Method, EstimatedEffect, SE)
# Combine
compare_all <- bind_rows(mast_compare, deseq_compare) |>
dplyr::left_join(true_effects, by = "gene")
ggplot2::ggplot(compare_all,
ggplot2::aes(x = TrueEffect,
y = EstimatedEffect,
color = Method)) +
ggplot2::geom_point(alpha = 1) +
ggplot2::geom_errorbar(ggplot2::aes(ymin = EstimatedEffect - 1.96 * SE,
ymax = EstimatedEffect + 1.96 * SE),
width = 0, alpha = 01) +
ggplot2::geom_abline(slope = 1, intercept = 0, linetype = "dashed") +
ggplot2::facet_wrap(~ Method) +
ggplot2::labs(
title = "True vs Estimated Effect Sizes with 95% CI",
x = "True Simulated Effect",
y = "Estimated Effect"
) +
ggplot2::theme_bw()
