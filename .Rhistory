run_app <- function(
onStart = NULL,
options = list(),
enableBookmarking = NULL,
uiPattern = "/",
...
) {
with_golem_options(
app = shinyApp(
ui = app_ui,
server = app_server,
onStart = onStart,
options = options,
enableBookmarking = enableBookmarking,
uiPattern = uiPattern
),
golem_opts = list(...)
)
}
pkgload::load_all('.')
app_server <- function(input, output, session) {
# load fixed data
data_path <- file.path('data','simData.rda')
if (!file.exists(data_path)) stop('data/simData.rda not found. Run R/data_prep.R first.')
load(data_path) # provides sim.pop.cond, mast_res, deseq_res
# make a small data list for modules
shared <- reactiveValues(
sim = sim.pop.cond,
mast = mast_res,
deseq = deseq_res
)
callModule(mod_overview_server, 'overview_1', shared = shared)
callModule(mod_pca_server, 'pca_1', shared = shared, colorBy = reactive(input$colorBy))
callModule(mod_umap_server, 'umap_1', shared = shared, colorBy = reactive(input$colorBy))
callModule(mod_volcano_server, 'volcano_1', shared = shared)
}
# To run interactively without golem packaging
if (interactive()) {
shiny::shinyApp(ui = app_ui, server = app_server)
}
app_ui <- function(request) {
fluidPage(
titlePanel('Single Cell Methods'),
sidebarLayout(
sidebarPanel(
helpText('Dataset precomputed and fixed (seed = 42).'),
selectInput('colorBy', 'Color points by:', choices = c('Condition','Sample'), selected = 'Condition'),
width = 3
),
mainPanel(
tabsetPanel(type = 'tabs',
tabPanel('Overview', mod_overview_ui('overview_1')),
tabPanel('PCA', mod_pca_ui('pca_1')),
tabPanel('UMAP', mod_umap_ui('umap_1')),
tabPanel('Volcano', mod_volcano_ui('volcano_1'))
)
)
)
)
}
runApp()
